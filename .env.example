# URL de la API (backend FastAPI). Flask la llama desde el servidor: no necesita ser pública.
BACKEND_URL=http://localhost:8000

# Firma la cookie de sesión. Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=

# Puerto del frontend. 8501 coincide con FRONTEND_URL del backend (destino de los QR y CORS).
PORT=8501

# 1 en producción (HTTPS): la cookie de sesión solo viaja cifrada.
COOKIE_SEGURA=0

# Minutos sin uso tras los que se cierra la sesión (equipos compartidos en terreno).
INACTIVIDAD_MINUTOS=30
